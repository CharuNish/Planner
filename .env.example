# Copy this file to .env.local for running on your laptop.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Login ---
APP_PASSWORD=choose-a-strong-password
# Any long random text (at least 32 characters). Keeps you logged in safely.
SESSION_SECRET=paste-a-long-random-string-here

# --- About you ---
OWNER_NAME=Charuka
TIMEZONE=Asia/Colombo
CURRENCY=Rs
# One number for every day, or 7 numbers for Mon,Tue,Wed,Thu,Fri,Sat,Sun
STUDY_TARGET_HOURS=2,2,3,2,2,6,6

# --- Google (service account) ---
# From the JSON key file you download: "client_email" and "private_key".
GOOGLE_CLIENT_EMAIL=planner-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The long ID in each sheet's link: docs.google.com/spreadsheets/d/<THIS PART>/edit
FINANCE_SHEET_ID=
STUDIES_SHEET_ID=

# Your calendar ID(s), comma separated. For your main calendar it is your Gmail address.
GOOGLE_CALENDAR_IDS=you@gmail.com

# --- Daily Telegram reminders (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random text. Vercel uses it to prove the daily reminder job is really from Vercel.
CRON_SECRET=

# --- Stage 2 ---
LIFE_SHEET_ID=
GEMINI_API_KEY=
# Optional: force a model. Leave empty to pick the newest free "flash" model automatically.
# GEMINI_MODEL=
YOUTUBE_API_KEY=
WEIGHT_GOAL_KG=
HEIGHT_CM=
SLEEP_TARGET_HOURS=7
WATER_TARGET_GLASSES=8

# Stage 4: Content
# Google Drive folder with one sub-folder per account (e.g. "Life with C - Instagram"), shared with the robot email.
CONTENT_FOLDER_ID=
# Optional: separate sheet for Posts/Captions/Followers/Channels tabs (defaults to the Life sheet).
CONTENT_SHEET_ID=
# Optional: automatic YouTube stats, e.g. "Life with C=@handle; Ane Manda=@handle"
YOUTUBE_CHANNELS=
